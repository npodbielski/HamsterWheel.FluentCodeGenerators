        <LangVersion>latestmajor</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>true</ImplicitUsings>
        <AssemblyName>HamsterWheel.FluentCodeGenerators</AssemblyName>
        <RootNamespace>HamsterWheel.FluentCodeGenerators</RootNamespace>
